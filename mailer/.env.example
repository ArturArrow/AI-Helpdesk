# Copy this file to .env and fill in your mail server's credentials.
PORT=3002

# Mailbox the helpdesk receives email in. Every email in IMAP_MAILBOX is forwarded to the
# webhook, then moved to IMAP_PROCESSED_MAILBOX (stored) or IMAP_FAILED_MAILBOX (rejected
# with 400/413). Both folders are created if missing. Anything else stays for the next pass.
# Use the server's full folder path: on servers whose folders sit under INBOX (INBOX.Sent,
# INBOX.Trash...) that's "INBOX.Processed", or the mailer won't find the folder it created.
IMAP_HOST="mail.example.com"
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER="support@example.com"
IMAP_PASSWORD=""
IMAP_MAILBOX="INBOX"
IMAP_PROCESSED_MAILBOX="Processed"
IMAP_FAILED_MAILBOX="Failed"
POLL_INTERVAL_MS=30000

# The server's inbound-email webhook; the secret is INBOUND_EMAIL_SECRET from server/.env.
WEBHOOK_URL="http://localhost:3001/api/webhooks/inbound-email"
INBOUND_EMAIL_SECRET=""

# Outgoing mail. SMTP_SECURE=true for port 465 (TLS), false for 587 (STARTTLS).
SMTP_HOST="mail.example.com"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="support@example.com"
SMTP_PASSWORD=""
MAIL_FROM="Helpdesk <support@example.com>"

# Shared secret for POST /send (sent as X-Mailer-Secret). Generate with: openssl rand -hex 32
MAILER_SECRET=""
