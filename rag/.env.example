# Copy this file to .env and fill in real values.

# Its own database with the pgvector extension, not the server's: Prisma would read these tables
# as drift. Percent-encode special characters in the password.
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_rag"
# Used only by the tests, which empty it. Must end in _test.
TEST_DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_rag_test"

# For the embeddings (text-embedding-3-small).
OPENAI_API_KEY=""

# Shared with the server (RAG_SECRET in server/.env). Generate with: openssl rand -hex 32
RAG_SECRET=""

# Sentry project DSN for error reporting. Optional: without it nothing is sent.
SENTRY_DSN=""
# Where it runs, e.g. production or staging. Blank: development.
SENTRY_ENVIRONMENT=""
