{
  "name": "server",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test src",
    "start:test": "bun --env-file=.env.test run src/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "bun run prisma/seed.ts",
    "db:seed:tickets": "bun run prisma/seed-tickets.ts",
    "db:seed:replies": "bun run prisma/seed-replies.ts",
    "eval:rag": "bun run scripts/evalRag.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^4.0.102",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sentry/bun": "^11.13.0",
    "ai": "^7.0.153",
    "better-auth": "^1.7.4",
    "core": "workspace:*",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "multer": "2.5.0",
    "pg": "^8.23.0",
    "pg-boss": "^12.38.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/pg": "^8.23.1",
    "dotenv": "^17.4.2",
    "prisma": "7.10.0",
    "typescript": "~6.0.2"
  }
}
