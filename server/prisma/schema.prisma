// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  admin
  agent
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  role          Role      @default(agent)
  // Soft delete: set instead of removing the row. Deleted users are hidden from lists and
  // can't sign in (session.create hook in src/lib/auth.ts); their email stays reserved.
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  replies       Reply[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// new: just arrived, waiting for the AI. processing: the AI is trying to resolve it from the
// knowledge base. Both are hidden from the ticket list; the AI then resolves it or leaves it open.
enum TicketStatus {
  new
  processing
  open
  resolved
  closed
}

enum TicketCategory {
  general_question
  technical_question
  refund_request
}

model Ticket {
  id           Int             @id @default(autoincrement())
  subject      String
  // Plain-text version of the email.
  body         String
  // HTML version of the email, when the sender included one.
  bodyHTML     String?
  senderEmail  String
  senderName   String
  // The email's Message-ID: dedupes redelivered webhooks, later used for threading replies.
  messageId    String?         @unique
  status       TicketStatus    @default(open)
  // Null until the ticket is classified.
  category     TicketCategory?
  // User.id of the assigned agent. A plain column, deliberately without a Prisma relation.
  assignedToId String?
  // When the ticket last became resolved or closed (by an agent or the AI); null while it's
  // not, and cleared when it's reopened. Feeds the dashboard's average resolution time.
  resolvedAt   DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  replies      Reply[]
  attachments  Attachment[]

  @@index([status])
  @@index([assignedToId])
  @@map("ticket")
}

enum ReplySender {
  agent
  customer
  ai
}

// Whether an agent or AI reply has been emailed to the customer (lib/sendReplyEmail.ts).
enum EmailStatus {
  pending
  sent
  failed
}

model Reply {
  id          Int          @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket       @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  body        String
  // HTML version of a customer's email, when the sender included one. Null for agent replies,
  // which are written as plain text.
  bodyHTML    String?
  // agent: written in the UI. customer: an email in the ticket's thread (Phase 6). ai: the answer
  // the AI resolved a new ticket with, from the knowledge base.
  sender      ReplySender
  // The Message-ID of the email: for a customer reply, the one it arrived with (dedupes
  // redelivered webhooks); for an agent or AI reply, the one it was sent with, set once it's
  // emailed. Either way it threads the customer's later answers onto the ticket.
  messageId   String?      @unique
  // Null for customer replies, and for replies stored while the mailer wasn't configured.
  emailStatus EmailStatus?
  // When the reply was emailed to the customer.
  sentAt      DateTime?
  authorId    String?
  author      User?        @relation(fields: [authorId], references: [id])
  createdAt   DateTime     @default(now())
  attachments Attachment[]

  @@index([ticketId, createdAt])
  @@map("reply")
}

// A file from a customer's email, or one an agent sent with a reply.
model Attachment {
  id          Int      @id @default(autoincrement())
  ticketId    Int
  ticket      Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  // The reply it came with; null when it came with the ticket's own email.
  replyId     Int?
  reply       Reply?   @relation(fields: [replyId], references: [id], onDelete: Cascade)
  filename    String
  contentType String
  size        Int
  // The Content-ID that an inline image's cid: link in the email's HTML points at.
  contentId   String?
  // Over the size limits: listed by name, but only the original email in the mailbox has the file.
  // Its own column because Prisma can't test data for null without reading the bytes.
  tooLarge    Boolean  @default(false)
  // Null when tooLarge. Only the download route and sendReplyEmail read it: select
  // attachmentSelect everywhere else.
  data        Bytes?
  createdAt   DateTime @default(now())

  @@index([ticketId])
  @@index([replyId])
  @@map("attachment")
}
