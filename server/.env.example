# Copy this file to .env and fill in real credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk?schema=public"

# Better Auth (generate secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3001"
CLIENT_URL="http://localhost:5173"

# Seeded admin account (bun run db:seed). Password must be 8-128 characters.
# In production set these (and BETTER_AUTH_SECRET) in the server environment;
# the placeholder admin@example.com is rejected when NODE_ENV=production.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD=""
ADMIN_NAME="Admin"

# Shared secret for POST /api/webhooks/* (sent as X-Inbound-Secret). Generate with: openssl rand -hex 32
INBOUND_EMAIL_SECRET=""

# OpenAI API key for the AI features (Polish reply). Optional: without it they answer 503.
OPENAI_API_KEY=""

# The mailer (mailer/, bun run dev:mailer) that emails agent and AI replies to the customer.
# Optional: without both, replies are only stored. MAILER_SECRET is the one in mailer/.env.
MAILER_URL="http://localhost:3002"
MAILER_SECRET=""

# The rag service (rag/, bun run dev:rag) that holds the knowledge base's documents.
# Optional: without both, /api/rag answers 503. RAG_SECRET is the one in rag/.env.
RAG_URL="http://localhost:3003"
RAG_SECRET=""

# Sentry project DSN for error reporting (5xx errors, failed background jobs).
# Optional: without it nothing is sent.
SENTRY_DSN=""
# Where it runs, e.g. production or staging. Blank: NODE_ENV, then development.
SENTRY_ENVIRONMENT=""
