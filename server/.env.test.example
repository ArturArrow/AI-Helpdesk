# Copy to .env.test for Playwright runs (bun run test:e2e from the repo root).
# Loaded only via `bun --env-file=.env.test`, so nothing falls through from .env.
# The database name must end in _test: `start:test` drops and re-migrates it on every run,
# and scripts/assert-test-db.ts refuses to reset anything else.
DATABASE_URL="postgresql://user:password@localhost:5432/helpdesk_test?schema=public"
NODE_ENV=test
PORT=3101

# Test-only secret (openssl rand -base64 32). Ports differ from dev so both can run at once.
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3101"
CLIENT_URL="http://localhost:5174"

# Seeded into the test database on every run.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="test-admin-password"
ADMIN_NAME="Admin"

# Sent as X-Inbound-Secret to POST /api/webhooks/*.
INBOUND_EMAIL_SECRET="test-inbound-email-secret"
